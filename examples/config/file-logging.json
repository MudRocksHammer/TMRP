{
  "environment": "development",
  "log_level": "INFO",
  "enqueue": true,
  "log_file": {
    "path": "logs/app_{time:YYYY-MM-DD_HH-mm-ss}.jsonl",
    "max_bytes": 10485760,
    "rotation_interval_seconds": 3600,
    "rotation_time": "00:00",
    "cleanup_days": 7,
    "compression": "zip",
    "delay": false
  }
}
